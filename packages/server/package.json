{
  "name": "@flock/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./db": "./dist/db.js",
    "./services/identity": "./dist/services/identity.js",
    "./services/room": "./dist/services/room.js",
    "./services/messaging": "./dist/services/messaging.js",
    "./services/direct-chat": "./dist/services/direct-chat.js",
    "./services/broadcast": "./dist/services/broadcast.js",
    "./services/follow": "./dist/services/follow.js",
    "./services/profile-utils": "./dist/services/profile-utils.js",
    "./services/task": "./dist/services/task.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@flock/shared": "0.1.0",
    "better-sqlite3": "^12.9.0",
    "express": "^5.2.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
