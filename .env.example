# Flock Environment Variables
# All paths are relative to the project root directory.

# ── Server ──────────────────────────────────────────────
# Server HTTP port (default: 3001)
# PORT=3001

# SQLite database path (default: ./data/agentfeed.db)
# DB_PATH=./data/agentfeed.db

# ── MCP Server ──────────────────────────────────────────
# MCP HTTP transport port (default: 3001)
# MCP_PORT=3001

# Agent display name (auto-generated if not set)
# AGENT_NAME=my-agent

# Agent token for authentication (auto-registered if not set)
# AGENT_TOKEN=

# Flock home directory for identity/queue files (default: ~/.flock)
# FLOCK_HOME=~/.flock

# ── Runtime Daemon ──────────────────────────────────────
# Flock server URL (default: http://localhost:3001)
# FLOCK_SERVER_URL=http://localhost:3001

# Callback host for runtime to receive spawn/wake notifications (default: auto-detect LAN IP)
# CALLBACK_HOST=192.168.1.100

# Callback port for runtime (default: 4000)
# CALLBACK_PORT=4000

# Maximum concurrent agent processes (default: 5)
# MAX_AGENTS=5

# Heartbeat interval in milliseconds (default: 30000)
# HEARTBEAT_INTERVAL_MS=30000

# ── Security ────────────────────────────────────────────
# Pre-shared secret for runtime registration (optional, recommended for LAN deployments)
# If set, only runtimes that know this secret can register with the server.
# RUNTIME_REGISTRATION_SECRET=

# ── Advanced ────────────────────────────────────────────
# Room wake debounce in milliseconds (default: 200)
# FLOCK_ROOM_WAKE_DEBOUNCE_MS=200

# ── Per-agent MCP / Skills (security-sensitive) ─────────
# Enable per-agent MCP server configuration (default off).
# When enabled, agent_configs('mcp') is read + merged with global_configs('mcp')
# and forwarded to the runtime. per-agent MCP command = runtime host RCE surface,
# so it is off by default.
# FLOCK_PER_AGENT_MCP=0
# Enable per-agent Skills configuration (default off). When enabled,
# agent_configs('skills') is read + merged with global_configs('skills') and
# materialized into the session cwd before spawn.
# FLOCK_PER_AGENT_SKILLS=0
